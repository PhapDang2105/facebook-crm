# Cấu hình mẫu cho kết nối Meta.
# Sao chép tệp này thành `.env` ở thư mục gốc rồi điền giá trị thật.
# Không commit tệp `.env`; tệp đã nằm trong .gitignore.

# CRM dùng ứng dụng Meta RIÊNG, không dùng chung với ứng dụng đang phục vụ
# hệ thống tự động hóa nội bộ, vì mỗi app chỉ có một Callback URL cho đối
# tượng Page. Chi tiết trong integrations/meta/README.md.
# App ID hiển thị ở App Dashboard.
META_APP_ID=

# App Secret: App Dashboard -> App settings -> Basic -> App secret -> Show.
META_APP_SECRET=

# Phiên bản Graph API mà ứng dụng đang dùng.
# Bản mới nhất tại thời điểm thiết lập là v26.0.
# Kiểm tra lại tại App Dashboard -> Webhooks -> cột "Phiên bản".
META_GRAPH_VERSION=v26.0

# Chuỗi bí mật tự đặt. Phải nhập y hệt vào ô "Verify token" khi cấu hình
# Webhooks trong Meta App. Nên dùng chuỗi ngẫu nhiên dài, không đoán được.
META_VERIFY_TOKEN=

# Domain HTTPS công khai trỏ về máy chủ đang chạy CRM, không có dấu "/" ở cuối.
# Meta chỉ gọi được webhook qua HTTPS nên đây là giá trị bắt buộc khi chạy thật.
PUBLIC_BASE_URL=https://fb.giotnang.vn

# Tùy chọn: đổi đường dẫn nhận webhook. Mặc định /webhooks/facebook.
# META_WEBHOOK_PATH=/webhooks/facebook

# Tùy chọn: OAuth redirect URI.
# Mặc định là ${PUBLIC_BASE_URL}/api/channels/meta/callback.
# META_REDIRECT_URI=

# Webhook nhận đơn từ landing page (Webcake...). Chuỗi bí mật tự đặt, dài và
# ngẫu nhiên. Cấu hình bên landing gọi POST tới:
#   ${PUBLIC_BASE_URL}/webhooks/landing?token=<LANDING_WEBHOOK_TOKEN>
# Để trống là tắt webhook.
LANDING_WEBHOOK_TOKEN=

# Pancake POS Open API, dùng để cảnh báo số điện thoại hay bom hàng (tra lịch
# sử đơn hoàn/huỷ và báo cáo theo số điện thoại của POS). Tạo khoá trong POS:
# Cài đặt → Nâng cao → Kết nối bên thứ ba → Webhook/API → API KEY → Tạo.
# Shop ID lấy ở GET https://pos.pages.fm/api/v1/shops?api_key=... hoặc trên URL POS.
# Để trống thì CRM chỉ dùng danh sách nhân viên tự đánh dấu.
POS_API_KEY=
POS_SHOP_ID=
# Đặt 1 để tắt đồng bộ đơn landing từ POS (mặc định chạy mỗi 5 phút khi POS đã kết nối).
POS_SYNC_DISABLED=
# Đẩy đơn CRM (bot chốt, nhân viên tạo) sang Pancake POS: đặt 0 để tắt; POS_WAREHOUSE_ID ghim kho tạo đơn (mặc định kho đầu tiên cho phép tạo đơn).
POS_PUSH_ORDERS=
POS_WAREHOUSE_ID=

# Cổng và địa chỉ lắng nghe của CRM.
# Luôn để 127.0.0.1, kể cả khi deploy lên VPS: reverse proxy (Caddy) chạy cùng
# máy nên gọi qua loopback là đủ. Mở ra 0.0.0.0 là đi vòng qua Caddy (HTTPS,
# header bảo mật, IP thật cho khoá đăng nhập) — đừng làm.
PORT=8080
HOST=127.0.0.1

# Đăng nhập CRM (trang /login) — lớp bảo vệ chính, Caddy không còn Basic Auth.
# Mỗi tài khoản là ten:chuoi-bam, cách nhau bằng dấu phẩy; chuỗi băm sinh bằng:
#   node app/auth.mjs hash-password
# Tài khoản ở đây (chủ shop) GỘP với Cài đặt → Nhân sự: chỉ cần MỘT nhân sự
# đang làm có mật khẩu là đăng nhập đã bật, dù dòng này để trống.
# Cả hai đều trống: máy local (http://localhost) không hỏi đăng nhập; máy chủ
# https (hay CRM_REQUIRE_LOGIN=1) trả 503 "Chưa cấu hình đăng nhập" — không mở toang.
CRM_LOGIN_USERS=
# Khoá ký cookie phiên (chuỗi ngẫu nhiên dài: openssl rand -hex 32). Để trống
# thì mỗi lần khởi động lại mọi người phải đăng nhập lại.
CRM_SESSION_SECRET=
# Tùy chọn: 1 = bắt buộc đăng nhập kể cả khi PUBLIC_BASE_URL không phải https;
# 0 = tắt bắt buộc (chỉ khi chạy local qua đường hầm https).
# CRM_REQUIRE_LOGIN=
# Tùy chọn: nơi lưu danh sách Nhân sự (mặc định data/processed/staff.json).
# STAFF_PATH=
# Tùy chọn: thư mục Lịch sử hoạt động, mỗi ngày một tệp JSONL theo giờ VN
# (mặc định data/processed/audit-log).
# AUDIT_LOG_DIR=

# Pancake (pages.fm): Page vận hành trong Pancake, bot của CRM trả lời khách qua
# Pancake. Cả ba giá trị lấy ở Pancake → Cài đặt → Công cụ của Page:
#   - PANCAKE_PAGE_ID: ID trang (Cài đặt chung hoặc mục Webhook hiện "ID trang").
#   - PANCAKE_PAGE_ACCESS_TOKEN: mục "Public API access token" → Tạo Token → Sao chép.
#   - PANCAKE_WEBHOOK_TOKEN: chuỗi bí mật tự đặt; dán vào ô Webhook của Pancake URL:
#       ${PUBLIC_BASE_URL}/webhooks/pancake?token=<PANCAKE_WEBHOOK_TOKEN>
# Để trống là tắt.
PANCAKE_PAGE_ID=
PANCAKE_PAGE_NAME=Giọt Nắng Healthy
PANCAKE_PAGE_ACCESS_TOKEN=
PANCAKE_WEBHOOK_TOKEN=
# Nhiều Page cùng lúc: mảng JSON [{"pageId":"...","pageName":"...","pageAccessToken":"..."}];
# khai ở đây thì PANCAKE_PAGE_ID/PANCAKE_PAGE_ACCESS_TOKEN ở trên chỉ là Page đầu (tùy chọn).
PANCAKE_PAGES=
# Mặc định bot im khi hội thoại đã có nhân viên nhận trong Pancake; đặt 1 để bot trả lời cả khi đã gán.
# PANCAKE_BOT_WHEN_ASSIGNED=0

# Mã QR trên thẻ cảm ơn (/q/<mã>, xem docs/plans/qr-the-cam-on.md). Mặc định
# đưa khách tới Page đầu tiên đã kết nối ở Cài đặt → Kênh; ghim cứng khi nối
# thêm Page thứ hai. QR_PAGE_NAME là tên hiện trên trang đệm (mặc định lấy tên
# Page, rồi PANCAKE_PAGE_NAME).
# QR_PAGE_ID=
# QR_PAGE_NAME=
# Mã QR duy nhất in lên thẻ (mặc định tmdt-01, trùng nguồn Pancake/Botcake) và tên hiện ở Cài đặt → Mã QR.
# QR_MAIN_CODE=
# QR_MAIN_LABEL=Thương mại điện tử
# Tin ưu đãi QR_OFFER gửi sau bao nhiêu mili giây kể từ lúc Meta báo referral,
# và mỗi hội thoại chỉ chào lại sau bao lâu. Để trống mẫu QR_OFFER là tắt.
# QR_GREETING_DELAY_MS=10000
# QR_GREETING_COOLDOWN_MS=21600000
# Page vận hành trong Pancake (tin nhắn đã về CRM qua webhook Pancake) nhưng QR
# thẻ cảm ơn trỏ về Page đó: nối thêm Page vào app Meta của CRM ở Cài đặt → Kênh
# và liệt kê ID ở đây, CRM sẽ chỉ đăng ký hai trường messaging_referrals và
# messaging_postbacks cho Page — nhận được ref của m.me và nút Bắt đầu mà hộp
# thư không nhận tin hai lần. Nhiều Page cách nhau bằng dấu phẩy.
# META_REFERRAL_ONLY_PAGES=

# Chatbot dùng Gemini qua Vertex AI (Google Cloud). Tệp khoá service account
# đặt ngoài thư mục dự án; mặc định /etc/facebook-crm/vertex-gemini-key.json.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/facebook-crm/vertex-gemini-key.json
# GOOGLE_CLOUD_PROJECT=
# Tùy chọn khi chạy thử: dùng access token có sẵn thay cho tệp khoá.
# VERTEX_ACCESS_TOKEN=

# Tùy chọn: đổi đường dẫn webhook landing/Pancake. CRM tự cho đường đã khai ở
# đây đi qua không cần đăng nhập (xác thực bằng token); Caddyfile không cần sửa.
# LANDING_WEBHOOK_PATH=/webhooks/landing
# PANCAKE_WEBHOOK_PATH=/webhooks/pancake
# Tùy chọn: đổi địa chỉ API (mặc định là địa chỉ chính thức của Pancake/POS).
# PANCAKE_API_BASE=
# POS_API_BASE=
# Gỡ lỗi: ghi thêm danh sách khoá của payload webhook vào log (đặt 1 để bật).
# PANCAKE_DEBUG_KEYS=
# WEBHOOK_DEBUG_KEYS=

# Quản lý chiến dịch (tab Chiến dịch): CRM đọc chi tiêu, hiển thị, lượt bấm và
# số cuộc trò chuyện của từng quảng cáo qua Facebook Marketing API — CHỈ ĐỌC,
# không bao giờ sửa/tắt quảng cáo. Token cần quyền ads_read (nên dùng token
# System User trong Business Manager, không hết hạn). Tài khoản quảng cáo
# lấy ở Trình quản lý quảng cáo (act_123… hoặc 123…), nhiều tài khoản cách
# nhau bằng dấu phẩy. Để trống là tắt; CRM tự đồng bộ mỗi 60 phút.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
# Đặt 1 để tắt vòng đồng bộ tự động (vẫn bấm Đồng bộ tay được).
# META_ADS_SYNC_DISABLED=
# Tùy chọn: đổi nơi lưu số liệu quảng cáo (mặc định data/processed/ad-insights.json).
# AD_INSIGHTS_PATH=
# Quy đơn trong hội thoại về chiến dịch theo lần bấm quảng cáo gần nhất trong
# bao nhiêu ngày trước lúc đặt (mặc định 7, tối đa 90).
# CAMPAIGN_ATTRIBUTION_DAYS=7

# Báo cáo tự động qua bot tuỳ chỉnh Lark. Webhook lấy trong nhóm Lark →
# Cài đặt → Bot → Thêm bot tuỳ chỉnh. Có URL là bật; mặc định mỗi ngày lúc
# 08:00 (giờ Việt Nam) gửi báo cáo của ngày hôm trước. Đặt ENABLED=0 để tạm tắt.
LARK_REPORT_WEBHOOK_URL=
# LARK_REPORT_ENABLED=1
# LARK_REPORT_TIME=08:00
# Tùy chọn: đổi nơi lưu ngày gửi gần nhất (mặc định data/processed/lark-report-state.json).
# LARK_REPORT_STATE_PATH=
