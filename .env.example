# Cấu hình mẫu cho kết nối Meta.
# Sao chép tệp này thành `.env` ở thư mục gốc rồi điền giá trị thật.
# Không commit tệp `.env`; tệp đã nằm trong .gitignore.

# CRM dùng ứng dụng Meta RIÊNG, không dùng chung với ứng dụng đang phục vụ
# hệ thống tự động hóa nội bộ, vì mỗi app chỉ có một Callback URL cho đối
# tượng Page. Chi tiết trong integrations/meta/README.md.
# App ID hiển thị ở App Dashboard.
META_APP_ID=

# App Secret: App Dashboard -> App settings -> Basic -> App secret -> Show.
META_APP_SECRET=

# Phiên bản Graph API mà ứng dụng đang dùng.
# Bản mới nhất tại thời điểm thiết lập là v26.0.
# Kiểm tra lại tại App Dashboard -> Webhooks -> cột "Phiên bản".
META_GRAPH_VERSION=v26.0

# Chuỗi bí mật tự đặt. Phải nhập y hệt vào ô "Verify token" khi cấu hình
# Webhooks trong Meta App. Nên dùng chuỗi ngẫu nhiên dài, không đoán được.
META_VERIFY_TOKEN=

# Domain HTTPS công khai trỏ về máy chủ đang chạy CRM, không có dấu "/" ở cuối.
# Meta chỉ gọi được webhook qua HTTPS nên đây là giá trị bắt buộc khi chạy thật.
PUBLIC_BASE_URL=https://fb.giotnang.vn

# Tùy chọn: đổi đường dẫn nhận webhook. Mặc định /webhooks/facebook.
# META_WEBHOOK_PATH=/webhooks/facebook

# Tùy chọn: OAuth redirect URI.
# Mặc định là ${PUBLIC_BASE_URL}/api/channels/meta/callback.
# META_REDIRECT_URI=

# Webhook nhận đơn từ landing page (Webcake...). Chuỗi bí mật tự đặt, dài và
# ngẫu nhiên. Cấu hình bên landing gọi POST tới:
#   ${PUBLIC_BASE_URL}/webhooks/landing?token=<LANDING_WEBHOOK_TOKEN>
# Để trống là tắt webhook.
LANDING_WEBHOOK_TOKEN=

# Pancake POS Open API, dùng để cảnh báo số điện thoại hay bom hàng (tra lịch
# sử đơn hoàn/huỷ và báo cáo theo số điện thoại của POS). Tạo khoá trong POS:
# Cài đặt → Nâng cao → Kết nối bên thứ ba → Webhook/API → API KEY → Tạo.
# Shop ID lấy ở GET https://pos.pages.fm/api/v1/shops?api_key=... hoặc trên URL POS.
# Để trống thì CRM chỉ dùng danh sách nhân viên tự đánh dấu.
POS_API_KEY=
POS_SHOP_ID=
# Đặt 1 để tắt đồng bộ đơn landing từ POS (mặc định chạy mỗi 5 phút khi POS đã kết nối).
POS_SYNC_DISABLED=
# Đẩy đơn CRM (bot chốt, nhân viên tạo) sang Pancake POS: đặt 0 để tắt; POS_WAREHOUSE_ID ghim kho tạo đơn (mặc định kho đầu tiên cho phép tạo đơn).
POS_PUSH_ORDERS=
POS_WAREHOUSE_ID=

# Cổng và địa chỉ lắng nghe của CRM.
# Luôn để 127.0.0.1, kể cả khi deploy lên VPS: reverse proxy (Caddy) chạy cùng
# máy nên gọi qua loopback là đủ. CRM KHÔNG có cơ chế đăng nhập riêng — toàn bộ
# lớp bảo vệ nằm ở Basic Auth của Caddy, nên mở ra 0.0.0.0 là để lộ thẳng mọi
# tin nhắn khách và mọi API quản trị ra Internet, đi vòng qua lớp đó.
PORT=8080
HOST=127.0.0.1

# Pancake (pages.fm): Page vận hành trong Pancake, bot của CRM trả lời khách qua
# Pancake. Cả ba giá trị lấy ở Pancake → Cài đặt → Công cụ của Page:
#   - PANCAKE_PAGE_ID: ID trang (Cài đặt chung hoặc mục Webhook hiện "ID trang").
#   - PANCAKE_PAGE_ACCESS_TOKEN: mục "Public API access token" → Tạo Token → Sao chép.
#   - PANCAKE_WEBHOOK_TOKEN: chuỗi bí mật tự đặt; dán vào ô Webhook của Pancake URL:
#       ${PUBLIC_BASE_URL}/webhooks/pancake?token=<PANCAKE_WEBHOOK_TOKEN>
# Để trống là tắt.
PANCAKE_PAGE_ID=
PANCAKE_PAGE_NAME=Giọt Nắng Healthy
PANCAKE_PAGE_ACCESS_TOKEN=
PANCAKE_WEBHOOK_TOKEN=
# Mặc định bot im khi hội thoại đã có nhân viên nhận trong Pancake; đặt 1 để bot trả lời cả khi đã gán.
# PANCAKE_BOT_WHEN_ASSIGNED=0
