# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Customer data. Mọi thư mục chứa dữ liệu thật đều phải nằm ngoài Git: một tệp
# CSV/XLSX khách thả nhầm vào đây mà lọt lên repo công khai thì không gỡ lại
# được. Chỉ samples/ (dữ liệu bịa để chạy thử) mới được commit.
data/processed/**
!data/processed/.gitkeep
data/raw/**
!data/raw/.gitkeep
data/incoming/**
!data/incoming/.gitkeep
data/quarantine/**
!data/quarantine/.gitkeep
data/exports/**
!data/exports/.gitkeep

# Logs and temporary files
logs/**
!logs/.gitkeep
*.log
tmp/
temp/

# Common tooling
.DS_Store
Thumbs.db
.idea/
.vscode/
node_modules/
tools/
.graphcode/
__pycache__/
.pytest_cache/

# Cấu hình chạy thử cục bộ của Claude Code (đường dẫn máy cá nhân)
.claude/launch.json

# Hồ sơ Chrome tạm của trình chạy UI, ảnh chụp thử, và repo tham khảo: không thuộc dự án
.tmp-ui-profile/
Claude outputs/
references/
