# Caddy đứng trước CRM: tự xin chứng chỉ HTTPS và chuyển mọi yêu cầu vào CRM
# (127.0.0.1:8080). Khớp máy chủ thật (fb.giotnang.vn) từ 01/10: KHÔNG còn
# Basic Auth — CRM tự hỏi đăng nhập (trang /login, tài khoản CRM_LOGIN_USERS
# trong .env + Cài đặt → Nhân sự).
#
# Thay <DOMAIN> bằng tên miền thật (vd fb.giotnang.vn).
#
# An toàn khi bỏ Basic Auth vì:
# - PUBLIC_BASE_URL là https nên CRM bắt buộc đăng nhập: chưa có tài khoản nào
#   thì CRM trả 503 "Chưa cấu hình đăng nhập", không mở toang (app/security.mjs).
# - Đường công khai do CRM tự quyết (app/auth.mjs isPublicPath): webhook Meta
#   (chữ ký X-Hub-Signature-256), /webhooks/landing và /webhooks/pancake (token),
#   /q/* (khách quét QR), /product-images/* (Messenger tải ảnh), /privacy (Meta
#   kiểm tra), /login. Mọi đường khác cần phiên đăng nhập.
# - CRM chỉ tin X-Forwarded-For khi kết nối từ 127.0.0.1/::1 (chính Caddy này),
#   và lấy địa chỉ CUỐI chuỗi (địa chỉ Caddy ghi) để khoá đăng nhập theo IP.
#   Caddy mặc định KHÔNG tin X-Forwarded-For khách tự gửi (không khai
#   trusted_proxies) — giữ nguyên như vậy.

<DOMAIN> {
	encode zstd gzip

	# Header bảo mật. CRM tự gắn các header này (và CSP cho trang HTML); "?" = chỉ
	# đặt khi CRM chưa gắn, để phản hồi lỗi của chính Caddy (502…) cũng có.
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		# Server-Sent Events cho hộp thư thời gian thực: không được đệm.
		flush_interval -1
		transport http {
			# Kết nối rảnh tới CRM đóng sau 60 giây — NGẮN hơn keepAliveTimeout của
			# CRM (65 giây, app/server.mjs), để Caddy không bao giờ dùng lại một kết
			# nối CRM vừa đóng (nguồn của 502 lác đác).
			keepalive 60s
		}
	}

	# Log đi vào journald, xem bằng: journalctl -u caddy -f
	# Không ghi ra tệp riêng: unit systemd của gói Caddy giới hạn thư mục được
	# phép ghi, nên "output file" làm dịch vụ chết ngay khi khởi động dù thư
	# mục đã chown đúng chủ.
	# Webcake gọi /webhooks/landing kèm ?token=… — ghi nguyên URI là token nằm
	# rõ trong journald, ai đọc được log hoặc hệ thống gom log đều lấy được.
	# Xoá riêng tham số đó khỏi log; phần còn lại giữ nguyên để còn lần vết.
	log {
		format filter {
			wrap json
			request>uri query {
				delete token
			}
		}
	}
}
