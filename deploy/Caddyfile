# Caddy đứng trước CRM: tự xin chứng chỉ HTTPS và chặn truy cập bằng mật khẩu.
#
# Thay <DOMAIN> bằng tên miền thật và <BCRYPT_HASH> bằng chuỗi băm sinh ra từ:
#   caddy hash-password
#
# Meta gọi webhook bằng máy, không đăng nhập được, nên đường dẫn webhook phải
# đi thẳng. Mọi đường dẫn còn lại đều yêu cầu Basic Auth vì ứng dụng CRM chưa
# có cơ chế đăng nhập của riêng nó.

<DOMAIN> {
	encode zstd gzip

	# Chỉ webhook của Meta được vào tự do; chính nó tự xác thực bằng chữ ký
	# X-Hub-Signature-256 nên không cần thêm lớp mật khẩu.
	@webhook path /webhooks/facebook
	handle @webhook {
		reverse_proxy 127.0.0.1:8080
	}

	# Webhook nhận đơn từ landing page (Webcake...): nền tảng gọi bằng máy,
	# tự xác thực bằng token trong URL/header (LANDING_WEBHOOK_TOKEN).
	@landing path /webhooks/landing
	handle @landing {
		reverse_proxy 127.0.0.1:8080
	}

	# Webhook tin nhắn từ Pancake (pages.fm): Pancake gọi bằng máy, tự xác thực
	# bằng token trong URL (PANCAKE_WEBHOOK_TOKEN); bot của CRM trả lời qua Pancake.
	@pancake path /webhooks/pancake
	handle @pancake {
		reverse_proxy 127.0.0.1:8080
	}

	# Ảnh sản phẩm cũng phải công khai: Messenger tải ảnh từ link này để hiện
	# trên receipt và sau bảng giá. Ứng dụng chỉ trả tệp ảnh có tên hợp lệ.
	@productImages path /product-images/*
	handle @productImages {
		reverse_proxy 127.0.0.1:8080
	}

	# Chính sách quyền riêng tư phải đọc được không cần đăng nhập: Meta kiểm tra
	# URL này để cho ứng dụng chuyển sang chế độ Chính thức.
	@privacy path /privacy /privacy.html
	handle @privacy {
		reverse_proxy 127.0.0.1:8080
	}

	# Mã QR trên phiếu cảm ơn trỏ vào đây. Khách quét là người ngoài, chưa đăng
	# nhập gì, nên phải đi thẳng. Ứng dụng chỉ nhận mã dạng chữ-số-gạch nối và
	# tự dựng địa chỉ đích, nên đường này không mở ra chuyển hướng tuỳ ý.
	@qr path /q/*
	handle @qr {
		reverse_proxy 127.0.0.1:8080
	}

	# Toàn bộ giao diện và API quản trị nằm sau mật khẩu.
	handle {
		basic_auth {
			<USERNAME> <BCRYPT_HASH>
		}
		reverse_proxy 127.0.0.1:8080 {
			# Server-Sent Events cho hộp thư thời gian thực: không được đệm.
			flush_interval -1
		}
	}

	# Log đi vào journald, xem bằng: journalctl -u caddy -f
	# Không ghi ra tệp riêng: unit systemd của gói Caddy giới hạn thư mục được
	# phép ghi, nên "output file" làm dịch vụ chết ngay khi khởi động dù thư
	# mục đã chown đúng chủ.
	# Webcake gọi /webhooks/landing kèm ?token=… — ghi nguyên URI là token nằm
	# rõ trong journald, ai đọc được log hoặc hệ thống gom log đều lấy được.
	# Xoá riêng tham số đó khỏi log; phần còn lại giữ nguyên để còn lần vết.
	log {
		format filter {
			wrap json
			request>uri query {
				delete token
			}
		}
	}
}
