{
  "manifest_version": 3,
  "name": "Giọt Nắng CRM – Cầu nối Pancake",
  "version": "1.1.2",
  "description": "Cho CRM fb.giotnang.vn gửi tin bám đuổi qua extension Pancake (gửi được ngoài 24 giờ) mà không phải chuyển sang tab Pancake.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://pancake.vn/*",
    "https://fb.giotnang.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fb.giotnang.vn/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
